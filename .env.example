# Environment variables for LawChain Backend API Example
# Copy this file to .env and fill in the actual values

# Backend API Configuration

# Application Settings
APP_NAME="LawChain Backend API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# API Settings
HOST="127.0.0.1"
PORT=8000

# Ollama Configuration
# Make sure Ollama is running on this URL
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=gemma2:2b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT=120

# Document Processing
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SIMILARITY_THRESHOLD=0.7
MAX_RETRIEVED_DOCS=5

# File Paths
DATA_DIR=data
VECTOR_STORE_LANGCHAIN_PATH=storage/vector_store_faiss
VECTOR_STORE_NATIVE_PATH=storage/vector_store_native
LOGS_DIR=logs
STORAGE_DIR=storage

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/lawchain.log
